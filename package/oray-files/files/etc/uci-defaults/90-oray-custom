#!/bin/sh
# Oray X1 Pro 定制默认值
# 语言:新版 LuCI 语言码为 zh_Hans,兼容旧 zh-cn
if [ -d /usr/lib/lua/luci/i18n ]; then
  if [ -f /usr/lib/lua/luci/i18n/base.zh-cn.lmo ]; then
    uci set luci.main.lang=zh-cn
  elif [ -f /usr/lib/lua/luci/i18n/base.zh_Hans.lmo ]; then
    uci set luci.main.lang=zh_Hans
  elif [ -f /usr/lib/lua/luci/i18n/base.zh_cn.lmo ]; then
    uci set luci.main.lang=zh_cn
  fi
fi
uci set luci.main.mediaurlbase=/luci-static/argon
uci commit luci

# WAN 接口佳底(设备全新状态时创建)
if ! uci -q show network.wan >/dev/null 2>&1; then
  uci set network.wan=interface
  uci set network.wan.proto=dhcp
  uci set network.wan.device=eth1
  uci set network.wan6=interface
  uci set network.wan6.device=eth1
  uci set network.wan6.proto=dhcpv6
  uci commit network
fi

# 防火墙默认放行 (保留 NAT, 不停止 fw4 服务)
uci set firewall.@defaults[0].input='ACCEPT'
uci set firewall.@defaults[0].output='ACCEPT'
uci set firewall.@defaults[0].forward='ACCEPT'
uci commit firewall

# ua3f: 默认启用 TPROXY 透明代理, 监听 0.0.0.0:1080, 开机自启
uci set ua3f.enabled.enabled='1'
uci set ua3f.main.server_mode='TPROXY'
uci set ua3f.main.port='1080'
uci set ua3f.main.bind='0.0.0.0'
uci commit ua3f
/etc/init.d/ua3f enable
exit 0
